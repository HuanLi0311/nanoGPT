{"task_id":"documentation_manifest","prompt":"[documentation/manifest_generation] Complete the workspace task and leave a verifier-checkable result.","domain":"documentation","subdomain":"manifest_generation","task_family":"documentation.manifest_generation","concepts":["documentation","manifest","inventory"],"materials":["manifest_generation_workspace","independent_verifier"],"files":{"src/main.py":"print('hello')\n","src/util.py":"VALUE = 1\n"},"verifier":"grep -qx 'src/main.py' manifest-*.txt && grep -qx 'src/util.py' manifest-*.txt && test \"$(cat manifest-*.ok)\" = complete","verifier_version":"synthesis-full-v1","harness_version":"workspace-tool-v1","tool_schema_version":"workspace-tools-v1","initial_facts":["workspace:ready"],"target_facts":[],"seed_patterns":["write_manifest","check_manifest"],"candidate_patterns":["write_manifest","check_manifest"],"max_steps":4,"action_patterns":[{"id":"write_manifest","tool":"exec_command","arguments_template":{"command":"find src -maxdepth 1 -type f -printf '%p\\n' | sort > manifest-{candidate_index}.txt"},"preconditions":["file:src/main.py:exists","file:src/util.py:exists"],"effects":["file:manifest-{candidate_index}:exists"]},{"id":"check_manifest","tool":"exec_command","arguments_template":{"command":"grep -qx src/main.py manifest-{candidate_index}.txt && grep -qx src/util.py manifest-{candidate_index}.txt && printf complete > manifest-{candidate_index}.ok"},"preconditions":["file:manifest-{candidate_index}:exists"],"effects":["file:manifest-{candidate_index}.ok:exists"]}]}
